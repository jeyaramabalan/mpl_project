{
  "name": "mpl-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node -r ./node-polyfill.cjs node_modules/expo/bin/cli start",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "node -r ./node-polyfill.cjs node_modules/expo/bin/cli prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "android": "node -r ./node-polyfill.cjs node_modules/expo/bin/cli start --android",
    "ios": "node -r ./node-polyfill.cjs node_modules/expo/bin/cli start --ios",
    "web": "node -r ./node-polyfill.cjs node_modules/expo/bin/cli start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "axios": "^1.15.1",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  }
}
